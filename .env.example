# PostgreSQL connection. For local dev, either use your own Postgres or run
# just the database from docker compose:  docker compose up db -d
DATABASE_URL="postgresql://cm:cm_dev_password@localhost:5432/corporate_mapper"

# Base URL of this app (used for OAuth redirect URIs and invite links)
APP_BASE_URL="http://localhost:3000"

# Secret used to encrypt CRM tokens at rest. REQUIRED in production.
# Generate one with: openssl rand -hex 32
APP_SECRET=""

# --- Salesforce (Connected App, OAuth 2.0 web server flow) ---
SFDC_CLIENT_ID=""
SFDC_CLIENT_SECRET=""
# Use https://test.salesforce.com for sandboxes
SFDC_LOGIN_URL="https://login.salesforce.com"

# --- HubSpot (OAuth app, or a Private App token for quick start) ---
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
# Quick start alternative: paste a Private App access token when creating a
# connection in Settings → Integrations instead of doing the OAuth dance.

# --- File storage for uploaded artifacts ---
# Default: local disk (fine for single-server deploys with a volume).
STORAGE_DIR="./storage"
# For serverless deploys (Vercel etc.) set an S3-compatible bucket instead —
# credentials via the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY:
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""            # only for R2 / MinIO / Spaces
# S3_FORCE_PATH_STYLE=""    # "true" for MinIO
